<!--
  Reglas personalizadas para "labapp" (IDs >= 100000)
  Destino: /var/ossec/etc/rules/local_rules.xml
  Tras editar: sudo systemctl restart wazuh-manager
-->
<group name="labapp,">

  <rule id="100100" level="0">
    <decoded_as>labapp</decoded_as>
    <description>labapp: evento de la aplicación</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <action>LOGIN_FAILED</action>
    <description>labapp: login fallido del usuario $(user) desde $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100101</if_matched_sid>
    <same_srcip />
    <description>labapp: posible fuerza bruta (5 fallos en 120 s) desde $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100103" level="3">
    <if_sid>100100</if_sid>
    <action>LOGIN_OK</action>
    <description>labapp: login correcto del usuario $(user) desde $(srcip)</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

</group>
